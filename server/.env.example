# WebVulnApp server configuration — copy to .env and fill in real values.
# NEVER commit the real .env.

# Node environment: development | production | test
NODE_ENV=development

# HTTP port for the Express API
PORT=5000

# MongoDB connection (local userspace instance by default)
MONGODB_URI=mongodb://127.0.0.1:27017/webvulnapp

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=8h

# Comma-separated list of allowed browser origins (CORS)
CLIENT_ORIGIN=http://localhost:5173

# Bootstrap admin, used ONLY by `npm run seed` (server/scripts). Remove after seeding.
ADMIN_EMAIL=admin@example.local
ADMIN_PASSWORD=change-me
ADMIN_NAME=Platform Admin

# --- Phase 3: scanner integration ---
# Python interpreter and scanner module invocation (safe spawn, no shell)
SCANNER_PYTHON=python3
SCANNER_ARGS=-m scanner.main
# Directory containing the scanner package (default: <repo>/scanner)
# SCANNER_CWD=/home/manik/webvulnapp/scanner
# Max scans running at once (extra requests queue FIFO)
SCAN_CONCURRENCY=2
# Where scanner JSON + generated PDFs are written (default: <repo>/.data)
# SCAN_DATA_DIR=/home/manik/webvulnapp/.data/scans
# REPORTS_DIR=/home/manik/webvulnapp/.data/reports
